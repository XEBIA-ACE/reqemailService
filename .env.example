# CarePay Project Test Suite Configuration File
# Updated for compatibility with new runtimes and frameworks (Angular, Node.js, Python, Java, Spring)
# Includes modern JavaScript testing frameworks (Jest, Cypress)
# All new/changed entries are commented

test:
  # Specify test environments for supported runtimes and frameworks
  environments:
    angular:                         # New: Added Angular test environment
      enabled: true                  # New: Enable Angular-specific testing
      framework: jest                # New: Use Jest for Angular unit tests
      e2e:
        enabled: true                # New: Enable end-to-end tests for Angular
        framework: cypress           # New: Use Cypress for Angular e2e tests
    nodejs:                          # New: Added Node.js backend test environment
      enabled: true                  # New: Enable Node.js testing
      framework: jest                # New: Use Jest for Node.js unit tests
    python:                          # New: Added Python backend test environment
      enabled: true                  # New: Enable Python testing
      framework: pytest              # New: Use pytest for Python unit tests
    java:                            # New: Added Java backend test environment
      enabled: true                  # New: Enable Java testing
      framework: junit               # New: Use JUnit for Java unit tests
      spring:
        enabled: true                # New: Enable Spring context tests
        framework: spring-test       # New: Use Spring Test for Spring integration tests

  # General test settings
  coverage:
    enabled: true                    # New: Enable code coverage reporting
    threshold: 85                    # New: Set minimum code coverage threshold (%)  
    report_formats:                  # New: Define code coverage report formats
      - html
      - lcov
      - xml

  reporting:
    junit_xml:                       # New: Enable junit-xml reporting for all languages
      enabled: true
      output_dir: reports/junit

  artifacts:
    output_dir: dist/test-results    # New: Centralized output directory for all test artifacts

  # CI-related keys (to be incorporated by downstream pipeline tools)
  ci:
    run_on_push: true                # New: Run tests automatically on push
    run_on_merge: true               # New: Run tests automatically on merge
    fail_on_coverage_drop: true      # New: Fail pipeline if coverage falls below threshold

# END OF TEST SUITE CONFIGURATION