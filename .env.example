# CarePay Flask & SQLAlchemy upgrade configuration template
# Updated for Flask 3.0 and SQLAlchemy 2.0 compatibility

[flask]
# Flask configuration section.
# Flask 3.0 does not require legacy settings; ensure new import style and compatible extensions.

SECRET_KEY = 'your-secret-key'  # Application secret key for sessions etc.

# New for Flask 3.0: Use FLASK_RUN_EXTRA_FILES to specify extra watched files if using flask run.
# FLASK_RUN_EXTRA_FILES =

# New for Flask 3.0: Set JSON_PROVIDER for customizing JSON handling.
# JSON_PROVIDER = 'default'  # 'default' uses Flask's default JSON provider (required in Flask 3.0+).

# Deprecated in Flask 3.0: JSON_AS_ASCII removed; Flask always uses UTF-8.
# JSON_AS_ASCII = False  # Deprecated; Flask 3.0 always uses UTF-8 for JSON responses.


[sqlalchemy]
# SQLAlchemy configuration section.
# SQLAlchemy 2.0 requires new API style and disables several legacy behaviors.

SQLALCHEMY_DATABASE_URI = 'sqlite:///your-database.db'  # Set your database URI here.
SQLALCHEMY_TRACK_MODIFICATIONS = False  # Recommended: disables Flask-SQLAlchemy event system overhead.

# New for SQLAlchemy 2.0: Explicit engine options
SQLALCHEMY_ENGINE_OPTIONS = {}
# Example: SQLALCHEMY_ENGINE_OPTIONS = {"future": True}  # 'future' mode is ON by default in SQLAlchemy 2.0.
# All engine options now fully support SQLAlchemy's 2.0 native API.

# SQLALCHEMY_ECHO and other debugging options
SQLALCHEMY_ECHO = False  # Log SQL queries for debugging.

# Removed/Deprecated in SQLAlchemy 2.0:
# SQLALCHEMY_NATIVE_UNICODE is removed in SQLAlchemy 2.0. Unicode is always native.
# SQLALCHEMY_NATIVE_UNICODE = True  # Deprecated—do not use.

# Deprecated in SQLAlchemy 2.0: SQLALCHEMY_POOL_RECYCLE replaced by pool_pre_ping.
# SQLALCHEMY_POOL_RECYCLE = 280  # Deprecated; use pool_pre_ping if needed.

# Example for Alembic migrations (if used)
[alembic]
# Alembic ini file section for migration settings.
# Ensure Alembic scripts/commands are SQLAlchemy 2.0+ context compatible.

script_location = migrations  # Path to your migration scripts.
sqlalchemy.url = sqlite:///your-database.db  # Use the same URI as SQLALCHEMY_DATABASE_URI.
# New: set 'sqlalchemy.enable_20' flag to ensure SQLAlchemy 2.0 mode
sqlalchemy.enable_20 = true  # Enforces SQLAlchemy 2.0 compatibility in Alembic env.

# End of configuration