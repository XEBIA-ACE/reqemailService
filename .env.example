# Documentation Configuration Template
# This template reflects the requirements for modernized documentation as per the latest stack and deployment upgrade.
# All keys are reviewed and updated to only reference current (modernized) components and deployment processes.

documentation:
  stack_overview: docs/stack_overview.md  # Updated: Path must point to modernized stack overview documentation.
  deployment_instructions: docs/deployment.md  # Updated: Points to modernized deployment process documentation.
  api_reference: docs/api_reference.md  # Updated: References updated API/interfaces reflecting the modern stack.
  configuration_examples: docs/config_examples.yaml  # Updated: Example configs must use modernized keys and formats.
  migration_guide: docs/migration_guide.md  # New: Added detailed steps for migrating from legacy to modernized stack.
  changelog: docs/changelog.md  # New: Documents all stack and deployment breaking changes for user awareness.
  troubleshooting: docs/troubleshooting.md  # New: Contains troubleshooting steps specific to the new stack and deployment.

# Deprecated configuration references removed:
# documentation.legacy_stack_overview: Removed; replaced by 'stack_overview'.
# documentation.legacy_deployment_instructions: Removed; replaced by 'deployment_instructions'.
# documentation.legacy_api_reference: Removed; replaced by 'api_reference'.

settings:
  default_language: en  # Specifies the documentation language (default: English).
  version: latest  # Refers to the latest stable stack version documentation.
  visibility: public  # Ensures docs are public unless otherwise restricted.
  format: markdown  # Specifies the markdown format for all documentation files.
  
  # Removed or commented out deprecated/legacy keys:
  # legacy_version: Deprecated; superseded by 'version: latest'.

metadata:
  last_updated: 2024-06-01  # New: Reflects the last update after modernization.
  maintainers:
    - name: Docs Team
      email: docs-team@example.com
  compliance_status: up_to_date  # New: Indicates docs reflect current operational stack and deployment.