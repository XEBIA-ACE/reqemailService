# Application Configuration File
# Secrets such as API keys, passwords, and tokens must now be provided via environment variables.
# Refer to the application documentation for the required environment variable names.
# Non-secret configuration values may remain hardcoded or be managed separately.

database:
  host: db.example.com
  port: 5432
  username: app_user
  # Password is no longer hardcoded. It must be provided at runtime via the DB_PASSWORD environment variable.
  password: ${DB_PASSWORD}   # Refactored: secret read from environment variable

api:
  # API key is now referenced via environment variable.
  key: ${API_KEY}            # Refactored: secret read from environment variable
  endpoint: https://api.example.com/v1/

smtp:
  server: smtp.example.com
  port: 587
  username: notifier@example.com
  # SMTP password must be provided via environment variable.
  password: ${SMTP_PASSWORD} # Refactored: secret read from environment variable

jwt:
  # JWT signing secret is now injected via an environment variable.
  secret: ${JWT_SECRET}      # Refactored: secret read from environment variable

redis:
  host: redis.example.com
  port: 6379
  # Optional: Redis password from environment variable, if required.
  password: ${REDIS_PASSWORD} # Refactored: secret read from environment variable

# Any other sensitive configuration must be similarly injected via environment variables.
# Remove any remaining hardcoded secrets from this file before deploying.