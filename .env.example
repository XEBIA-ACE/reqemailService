# Modernized Documentation Configuration Template
# This configuration aligns documentation generation and deployment
# with the updated, modernized stack and workflows.

# Documentation language and output settings.
documentation:
  # The target language or markup for documentation (update as per modern stack).
  format: markdown  # Updated to reflect modern documentation standards.

  # The default documentation directory.
  docs_dir: docs  # Ensures docs are stored in the correct, modern location.

  # Where built documentation should be output.
  build_dir: site  # Updated output directory for documentation builds.

# Build and deployment integration for documentation.
build:
  generator: mkdocs  # Modern static site generator for documentation.
  # mkdocs supports markdown and is simple for containerized/CICD deployments.

  # Modern deployment commands for documentation.
  commands:
    - mkdocs build  # Builds the documentation site.
    - mkdocs serve  # For local preview before deployment.

deploy:
  # Modern deployment process should utilize container- and CI-native workflows.
  method: ci-cd  # Indicates use of CI/CD system for deploying docs.

  # Document the pipeline or process used for deployment.
  pipeline: github-actions  # Example: use GitHub Actions for documentation deployment.

  # The remote location/documentation site to deploy to.
  destination: gh-pages  # Typical modern docs deployment target.

# Guide configuration (ensures up-to-date deployment instructions)
guides:
  deployment:
    # Up-to-date documentation reflecting current stack and workflow.
    overview: ./docs/deployment.md  # Modernized deployment guide location.
    prerequisites: ./docs/prerequisites.md  # Modern stack/dependency requirements.

# Configuration files and environment variable references.
configuration:
  # Modern location for configuration documentation.
  config_docs: ./docs/configuration.md

  # Example environment file reflecting new stack (if applicable).
  env_example: ./docs/.env.example

# Code Examples
code_examples:
  language: latest  # Indicate all examples reflect latest stable language in the stack.
  location: ./docs/examples  # Directory for current, example code snippets.

# Deprecated/Legacy Sections (for tracking phase-out; comment out when upgraded)
# legacy:
#   - old_build_tools.md
#   - obsolete_deployment.md
#   - legacy_config.md
#   These files have been deprecated and replaced by modern documentation as noted above.

# End of configuration template.