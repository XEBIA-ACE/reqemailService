[sqlalchemy]
# SQLAlchemy main configuration for 2.0.x
# Updated to reflect changes from 1.3 to 2.0.x

# SQLAlchemy database URL (example value, replace as needed)
sqlalchemy.url = sqlite:///example.db

# Use new-style Engine settings for SQLAlchemy 2.0.x
# The 'future' flag is now deprecated and should not be used in 2.0.x 
# 'future = true' is removed; SQLAlchemy 2.0 engines always use 2.x behavior

# echo: set to 'true' to log SQL statements executed
echo = false

# pool_pre_ping: checks connection liveness, recommended for production
pool_pre_ping = true

# pool_size: the number of connections to keep in the pool
pool_size = 5

# max_overflow: additional connections above pool_size
max_overflow = 10

# The 'use_native_unicode' and 'convert_unicode' options are deprecated in 2.0.x
# use_native_unicode = false  # deprecated in SQLAlchemy 2.0.x
# convert_unicode = false     # deprecated in SQLAlchemy 2.0.x

# future: removed, 2.0.x defaults to 2.x engine
# future = true

# New in 2.0: 'hide_parameters' controls display of bound parameter values in logs
hide_parameters = true  # Hide sensitive parameters from logs by default

# New in 2.0: 'enable_two_phase' explicit control of two-phase commit support
enable_two_phase = false  # Only set to true if using two-phase commit

# Removed in 2.0: 'native_datetime' is not supported
# native_datetime = false  # deprecated/removed

# Transaction isolation level: string values like 'READ COMMITTED', 'SERIALIZABLE', etc.
isolation_level = READ COMMITTED  # Set isolation level as needed

# Null pool (if using, can set poolclass = sqlalchemy.pool.NullPool)

# [End of configuration for SQLAlchemy 2.0.x]