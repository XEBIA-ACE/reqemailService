# Modernized Test Suite configuration template
# Generated for latest stable language/runtime and testing standards
# All keys include inline comments, especially for new or changed items.

test_suite:
  # Defines the root directory where tests are located
  test_root: "tests"

  # Specifies the pattern to discover test files
  # Updated for modern test discovery mechanisms
  test_pattern: "test_*.py"  # New: Uses glob for test filename matching as per contemporary standards

  # Enables or disables parallel test execution
  # New: Parallel execution improves speed and matches modern best practices
  enable_parallel: true

  # Sets the number of parallel workers for test runs
  # New: Exposes worker count for tuning based on hardware availability
  worker_count: 4

  # Enables capturing stdout/stderr during test runs
  capture_output: true  # New: Ensures clean test output capturing as expected currently

  # Toggles colored output in test reports
  colored_output: true  # New: Improves output readability

  # Fail the test run after the first failure if enabled
  # Modern practice allows for early feedback in long-running suites
  fail_fast: false

  # Enables test result summaries and reporting
  # New: Summarized reporting is a contemporary default
  enable_summary: true

  # Code coverage options
  # Code coverage is now standard in mature test suites
  coverage:
    enabled: true  # New: Coverage must be enabled for all modernized suites
    report_format: "html"  # New: HTML reporting for easier review
    fail_under: 80  # New: Require at least 80% coverage, common current threshold

  # Test seed for reproducibility
  # New: Exposing test seed guarantees reproducible random-based tests
  seed: 12345

  # Enables fixture auto-discovery
  # New: Modern test frameworks auto-discover fixtures by default
  fixture_autodiscover: true

  # Markers and tagging support
  # Contemporary suites use marker/tag systems for test selection and filtering
  markers:
    # Examples; add as needed
    - "integration"
    - "slow"
    - "smoke"

  # Enables deprecation warnings as errors
  # New: Catches use of any soon-to-be-removed APIs in tests
  treat_deprecation_warnings_as_errors: true

  # Logging configuration for test runs
  logging:
    level: "INFO"  # New: Ensure consistent log visibility for debugging
    to_file: false

  # List of external plugins or test extensions in use
  plugins: []

  # Deprecated/removed keys:
  # test_file_regex: ".*Tests\\.py"  # Deprecated: replaced by test_pattern for modern discovery

  # Additional custom test framework options can be inserted below as needed